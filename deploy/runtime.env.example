# Copy to /opt/tradingapp/runtime.env on the VM; chmod 600. Never commit real keys.
# Buy/wait/avoid signals require only these two settings, not OpenAI.
# News and metrics: use a plan permitting your application's display/use of data.
FINNHUB_API_KEY=
DATA_PROVIDER_TERMS_ACCEPTED=false
# Set the actual current input/output USD prices per ONE MILLION tokens for AI_MODEL.
# AI summaries are disabled until both prices and the key are configured. Signals still work.
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
# Internal ceiling cannot exceed $8, leaving $2 headroom in the $10 monthly budget.
AI_MONTHLY_LIMIT_USD=8
# SEC requires an identifying application name and a real contact email address.
SEC_USER_AGENT=
